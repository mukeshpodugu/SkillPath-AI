# EduPath AI Environment Configuration Template

# ================= AUTHENTICATION & SECURITY =================
JWT_SECRET=your_jwt_secret_key_here
# Optional Firebase Admin SDK (falls back to built-in cryptographic tokens if omitted)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# ================= TRANSACTIONAL EMAIL NOTIFICATIONS =================
# Optional SMTP configuration (falls back to database audit sandbox if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=notifications@edupath-ai.edu

# ================= PAYMENTS & SUBSCRIPTIONS =================
# Optional Razorpay API credentials (falls back to built-in sandbox simulator if omitted)
RAZORPAY_KEY_ID=rzp_test_your_sandbox_key_id
RAZORPAY_KEY_SECRET=your_sandbox_secret

# ================= FRONTEND VITE CONFIGURATION =================
VITE_API_BASE_URL=http://localhost:8000/api
